# OpenAI API 配置
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your-api-key
MODEL_NAME=deepseek-v4-pro
MODEL_CONTEXT_LENGTH=128000
MODEL_MAX_COMPLETION_TOKEN=128000
TEMPERATURE=0.7
LLM_API_TIMEOUT=60

# Bocha 搜索 API Key
BOCHA_API_URL=https://api.bocha.cn/v1/web-search
BOCHA_API_KEY=""

# Email工具 SMTP 服务器配置
# SMTP 服务器地址，例如: smtp.gmail.com
EMAIL_SMTP_SERVER=""
# 加密方式：NONE、SSL、TLS
EMAIL_SMTP_ENCRYPTION=SSL
# SMTP 端口，默认 465 (SSL)
EMAIL_SMTP_PORT=465
# SMTP 用户名（通常是邮箱地址）
EMAIL_SMTP_USERNAME=""
# SMTP 密码或应用专用密码
EMAIL_SMTP_PASSWORD=""
# 发信人显示名称
EMAIL_FROM_NAME=LemonClaw

# 工具安全管控
ENABLE_BASH_TOOL=false
FILE_SAFE_DIRS="."

# Agent行为配置
# Agent ReAct 一轮对话最大迭代的次数
AGENT_REACT_MAX_ITERATIONS=20

# 上下文中最少完整保留的消息数
CONTEXT_MIN_FULL_MESSAGES=20

# Webhook
ENABLE_WEBHOOK=true
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8765
# WebHook 身份验证令牌（可选，设置后请求必须在 Header 中携带 X-Auth-Token）
WEBHOOK_AUTH_TOKEN=""
# 每分钟请求频率限制（默认 10）
WEBHOOK_RATE_LIMIT_RPM=10

# feishu
ENABLE_FEISHU=false
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# 持久化记忆
# 记忆系统总开关，false 时 AgentService 不初始化记忆、命令返回「未启用」
ENABLE_MEMORY=true
# 单轮注入记忆上下文的最大 Token 预算（核心记忆 > 最近会话 > 检索块 按优先级裁剪）
MEMORY_MAX_CONTEXT_TOKENS=1500
# 注入的最近会话摘要数量
MEMORY_RECENT_SESSIONS=3
# 加载进 TF-IDF 检索索引的长期记忆块上限
MEMORY_MAX_SEARCH_CHUNKS=100
# 会话结束时是否自动抽取摘要/记忆块归档到长期记忆
MEMORY_AUTO_ARCHIVE=true

# Skills 技能系统
# 技能系统总开关，false 时 AgentService 不初始化技能、命令返回「未启用」
ENABLE_SKILLS=true
# 是否启用 run_skill_script 工具（执行技能脚本，代码执行能力，默认关闭）
ENABLE_SKILL_SCRIPT=false
# 同时激活的技能数上限（超出 LRU 淘汰最久未活跃者）
MAX_ACTIVE_SKILLS=5
# 技能依赖安装镜像源（国内默认；可改为官方 https://pypi.org/simple 与 https://registry.npmjs.org）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
# run_skill_script 执行超时（秒）
SKILL_SCRIPT_TIMEOUT=120
# 技能包存放于 .lemonclaw/skills/（固定，不可配置；.lemonclaw/ 须挂载为持久卷）

# MCP 接入（仅 Streamable HTTP）
# MCP 接入总开关，false 时 AgentService 不初始化 MCPManager、/mcp 命令返回"未启用"
ENABLE_MCP=true
# 连接（initialize / tools/list）超时（秒）
MCP_CONNECT_TIMEOUT=30
# 工具调用（tools/call）超时（秒）；部分 MCP 工具耗时较长，默认 300s
MCP_CALL_TIMEOUT=300
# 单 MCP 服务端注册工具数上限（超出截断并告警）
MCP_MAX_TOOLS=100
# MCP 工具结果截断阈值（保首尾）
MCP_RESULT_MAX_CHARS=20000
# MCP 服务端声明式配置固定为 .lemonclaw/mcp.json（含认证密钥，须 gitignored；
# 团队共享用 .lemonclaw/mcp.json.example 模板）。headers 为服务端连接配置，不进 LLM 上下文

# 多 Agent 工作流（基于 LangGraph）
# 工作流总开关，false 时 AgentService 不初始化 WorkflowManager、/wf 命令返回"未启用"
ENABLE_WORKFLOW=true
# 单次 invoke 最大 super-step 数（防环死循环）
WORKFLOW_RECURSION_LIMIT=50
# 工作流静态嵌套深度上限（subgraph 节点）
WORKFLOW_NESTING_MAX=5
# 单工作流节点数上限
WORKFLOW_MAX_NODES=50
# 条件边分支数上限
WORKFLOW_MAX_BRANCHES=20
# run 输出/payload 文本截断阈值（保首尾）
WORKFLOW_RESULT_MAX_CHARS=20000
# 后台执行工作流分段的线程池大小
WORKFLOW_WORKER_POOL_SIZE=4
# human 节点默认 handler（interactive/feishu_card/webhook/email）
WORKFLOW_HITL_DEFAULT_HANDLER=interactive
