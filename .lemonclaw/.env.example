# OpenAI API 配置
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your-api-key
MODEL_NAME=deepseek-v4-pro
MODEL_MAX_TOKEN=128000
TEMPERATURE=0.7
LLM_API_TIMEOUT=60

# Bocha 搜索 API Key
BOCHA_API_URL=https://api.bocha.cn/v1/web-search
BOCHA_API_KEY=""

# Email工具 SMTP 服务器配置
# SMTP 服务器地址，例如: smtp.gmail.com
EMAIL_SMTP_SERVER=""
# 加密方式：NONE、SSL、TLS
EMAIL_SMTP_ENCRYPTION=SSL
# SMTP 端口，默认 465 (SSL)
EMAIL_SMTP_PORT=465
# SMTP 用户名（通常是邮箱地址）
EMAIL_SMTP_USERNAME=""
# SMTP 密码或应用专用密码
EMAIL_SMTP_PASSWORD=""
# 发信人显示名称
EMAIL_FROM_NAME=LemonClaw

# 工具安全管控
ENABLE_BASH_TOOL=false
FILE_SAFE_DIRS="."

# Agent行为配置
# Agent ReAct 一轮对话最大迭代的次数
AGENT_REACT_MAX_ITERATIONS=20

# 上下文中最少完整保留的消息数
CONTEXT_MIN_FULL_MESSAGES=20

# Webhook
ENABLE_WEBHOOK=true
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8765
# WebHook 身份验证令牌（可选，设置后请求必须在 Header 中携带 X-Auth-Token）
WEBHOOK_AUTH_TOKEN=""
# 每分钟请求频率限制（默认 10）
WEBHOOK_RATE_LIMIT_RPM=10
