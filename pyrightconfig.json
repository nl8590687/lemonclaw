{
  "include": ["main.py"],
  "exclude": [
    ".git",
    ".lemonclaw",
    ".venv",
    "build",
    "dist",
    "tests"
  ],
  "ignore": [
    "agent",
    "channels",
    "config",
    "dao",
    "command.py",
    "loop.py",
    "tests"
  ],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.13",
  "reportMissingImports": "error",
  "reportMissingModuleSource": "none"
}
